{
  "name": "vop-investimentos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VOP Investimentos Imobiliários — site institucional.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "images": "node scripts/optimize-images.mjs",
    "videos": "node scripts/optimize-videos.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "poster": "node scripts/hero-poster.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
