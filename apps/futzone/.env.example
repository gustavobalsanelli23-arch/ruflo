# ─────────────────────────────────────────────────────────────────────────────
# Acesso ao painel administrativo (/admin) — SOMENTE no servidor.
# Copie para `.env.local` (desenvolvimento) ou cadastre em
# Vercel → Settings → Environment Variables. NUNCA faça commit dos valores.
#
# Gere o hash de cada senha com:   npm run admin:hash
# (ou na própria tela /admin/login enquanto nenhum admin estiver configurado)
# ─────────────────────────────────────────────────────────────────────────────

# Administrador 1
FUTZONE_ADMIN_1_NAME=
FUTZONE_ADMIN_1_EMAIL=
FUTZONE_ADMIN_1_PASSWORD_HASH=

# Administrador 2
FUTZONE_ADMIN_2_NAME=
FUTZONE_ADMIN_2_EMAIL=
FUTZONE_ADMIN_2_PASSWORD_HASH=

# Segredo que assina as sessões (mín. 32 caracteres aleatórios).
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FUTZONE_ADMIN_SESSION_SECRET=

# Opcional: troque o valor (ex.: 2, 3…) para encerrar todas as sessões abertas.
FUTZONE_ADMIN_SESSION_VERSION=1
