# SOLUS — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Project → Settings →
# Environment Variables). Nunca commite valores reais.
#
# Todas são lidas só no servidor, em tempo de execução. Nenhuma usa o prefixo
# NEXT_PUBLIC_: o navegador nunca recebe chaves do Supabase.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → chave publicável (sb_publishable_…).
# Também aceita a chave "anon" legada em SUPABASE_ANON_KEY. Não é secreta: o RLS protege os dados.
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → chave secreta (sb_secret_…).
# Também aceita a "service_role" legada em SUPABASE_SERVICE_ROLE_KEY.
# SECRETA. Ignora o RLS. Usada apenas no limite de tentativas de login, cadastro e
# recuperação de senha. Em produção, sem ela, essas operações são recusadas.
SUPABASE_SECRET_KEY=

# Endereço público do app, usado nos links enviados por e-mail (confirmação,
# recuperação e convites). Na Vercel pode ficar vazio: usa o domínio de produção.
SITE_URL=

# ---------- Analista de IA (opcional; sem chave, o analista fica oculto) ----------
# Provedor: "anthropic" (Claude) ou "openai" (APIs compatíveis com OpenAI: Groq,
# OpenRouter, Gemini, Cerebras, DeepSeek…). Vazio: anthropic se houver
# ANTHROPIC_API_KEY, senão openai se houver algum provedor abaixo.
SOLUS_AI_PROVIDER=

# Claude: chave, modelo (padrão claude-opus-5-5) e esforço (low, medium, high)
ANTHROPIC_API_KEY=
SOLUS_AI_MODEL=
SOLUS_AI_EFFORT=

# Compatíveis com OpenAI, em ordem de preferência (1 a 9). Quando um atinge o
# limite (ou fica sem saldo, ou cai), o próximo responde, e o que falhou descansa
# pelo tempo que ele pedir (Retry-After), ou 1 min por padrão.
# Do 2 em diante, sem API_KEY e BASE_URL, usa os do anterior: o mesmo provedor
# com outro modelo, que nos planos grátis costuma ter limite próprio.
# URLs (confira na documentação de cada um, e os ids de modelo no painel deles):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1   (modelos grátis terminam em ":free")
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Cerebras    https://api.cerebras.ai/v1
#   DeepSeek    https://api.deepseek.com (pago)
# Planos grátis podem guardar e usar o que é enviado: com dados reais de clientes,
# leia os termos de cada provedor antes.
SOLUS_AI_1_API_KEY=
SOLUS_AI_1_BASE_URL=
SOLUS_AI_1_MODEL=
SOLUS_AI_2_MODEL=
SOLUS_AI_3_API_KEY=
SOLUS_AI_3_BASE_URL=
SOLUS_AI_3_MODEL=
# Opcionais por provedor: SOLUS_AI_n_MAX_TOKENS (limite de saída) e SOLUS_AI_n_NAME (nome nos logs).
# As variáveis sem número (SOLUS_AI_API_KEY, SOLUS_AI_BASE_URL, SOLUS_AI_MODEL) valem como provedor 1.

# Limite de saída por chamada (padrão 8000) e esquemas estritos ("on", só se todos suportarem)
SOLUS_AI_MAX_TOKENS=
SOLUS_AI_STRICT_TOOLS=

# IA na demonstração pública: "on" + código de 8+ caracteres
SOLUS_DEMO_AI=
SOLUS_DEMO_AI_CODE=

# Somente testes de banco (npm run test:db): conexão de SUPERUSUÁRIO a um
# PostgreSQL descartável. Ex.: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SOLUS_TEST_DATABASE_URL=

# Somente E2E com Supabase real (npm run test:e2e:real), sempre um projeto de TESTE.
SOLUS_E2E_BASE_URL=
SOLUS_E2E_SUPABASE_URL=
SOLUS_E2E_SUPABASE_SECRET_KEY=
SOLUS_E2E_EMAIL_DOMAIN=
