# SOLUS — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Project → Settings →
# Environment Variables). Nunca commite valores reais.
#
# Todas são lidas só no servidor, em tempo de execução. Nenhuma usa o prefixo
# NEXT_PUBLIC_: o navegador nunca recebe chaves do Supabase.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → chave publicável (sb_publishable_…).
# Também aceita a chave "anon" legada em SUPABASE_ANON_KEY. Não é secreta: o RLS protege os dados.
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → chave secreta (sb_secret_…).
# Também aceita a "service_role" legada em SUPABASE_SERVICE_ROLE_KEY.
# SECRETA. Ignora o RLS. Usada apenas no limite de tentativas de login, cadastro e
# recuperação de senha. Em produção, sem ela, essas operações são recusadas.
SUPABASE_SECRET_KEY=

# Endereço público do app, usado nos links enviados por e-mail (confirmação,
# recuperação e convites). Na Vercel pode ficar vazio: usa o domínio de produção.
SITE_URL=

# ---------- Analista de IA (opcional; sem chave, o analista fica oculto) ----------
# Provedor: "anthropic" (Claude) ou "openai" (qualquer API compatível com OpenAI:
# DeepSeek, OpenRouter, Groq…). Vazio: anthropic se houver ANTHROPIC_API_KEY,
# senão openai se houver SOLUS_AI_API_KEY.
SOLUS_AI_PROVIDER=

# Claude
ANTHROPIC_API_KEY=

# Compatível com OpenAI. Exemplos:
#   DeepSeek:   SOLUS_AI_BASE_URL=https://api.deepseek.com      SOLUS_AI_MODEL=deepseek-chat
#   OpenRouter: SOLUS_AI_BASE_URL=https://openrouter.ai/api/v1  SOLUS_AI_MODEL=deepseek/<modelo>:free
# Confira os ids atuais em https://openrouter.ai/models e na documentação do DeepSeek.
# Modelos ":free" do OpenRouter podem guardar e usar o que é enviado: use só na demonstração.
SOLUS_AI_API_KEY=
SOLUS_AI_BASE_URL=
SOLUS_AI_MAX_TOKENS=
SOLUS_AI_STRICT_TOOLS=

# Modelo (padrão claude-opus-5-5 ou deepseek-chat) e esforço (só Claude: low, medium, high)
SOLUS_AI_MODEL=
SOLUS_AI_EFFORT=

# IA na demonstração pública: "on" + código de 8+ caracteres
SOLUS_DEMO_AI=
SOLUS_DEMO_AI_CODE=

# Somente testes de banco (npm run test:db): conexão de SUPERUSUÁRIO a um
# PostgreSQL descartável. Ex.: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SOLUS_TEST_DATABASE_URL=

# Somente E2E com Supabase real (npm run test:e2e:real), sempre um projeto de TESTE.
SOLUS_E2E_BASE_URL=
SOLUS_E2E_SUPABASE_URL=
SOLUS_E2E_SUPABASE_SECRET_KEY=
SOLUS_E2E_EMAIL_DOMAIN=
